# Public runtime config, committed so every developer and EAS build shares the
# same defaults. Only EXPO_PUBLIC_* vars reach the app bundle, and everything
# in this file ships to devices — never put a service_role key or a Postgres
# connection string here. `.env.local` overrides anything set below.
EXPO_PUBLIC_API_URL=https://api.ligo.app

# Supabase Data API. The publishable key is designed to be public; Row Level
# Security on each table is what actually protects the data.
# EXPO_PUBLIC_SUPABASE_URL=https://tblujcawpwvedllowuuy.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_yaJG9PPcOdONyxsQt1YFVQ_jQ3-LqZN


EXPO_PUBLIC_SUPABASE_URL=https://kwqcmnhnjpldtialcwks.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_IVimMXVsykRxhOkc7Q44Eg_xTQ7n72R



# Run the data modules against src/api/mocks/ instead of the network.
#
# Now false: the training loop, the roster, onboarding, Today, Progress and
# the client profile all read Supabase. The modules that have not been swapped
# still point at EXPO_PUBLIC_API_URL above, which does not resolve — those
# screens show their error state rather than data. Most are hidden behind a
# feature flag below; the ones that are not are listed in supabase/README.md.
#
# Auth is the exception either way: src/api/auth.ts, googleAuth.ts and
# passwordReset.ts never branch on this flag and always talk to Supabase.
EXPO_PUBLIC_USE_MOCKS=false


# Google sign-in needs NO credentials here. The client ID and secret belong in
# Supabase → Authentication → Providers → Google, which holds the secret
# server-side and does the token exchange. An OAuth client secret must never
# sit in this repo or in an EXPO_PUBLIC_* var — that ships it to every device.

# ---------------------------------------------------------------------------
# Feature flags — which parts of the app this build has at all.
#
# Not entitlement and not a per-user setting: Ligo is being built domain by
# domain against a real backend, and a tab that opens onto an error is worse
# than a tab that is not there. A flag being off removes the feature
# everywhere at once — its tab, and every card on another screen that reads
# from it, so Today's macros and the Food tab can never disagree about
# whether food logging exists.
#
# Off unless explicitly "true". A feature nobody enabled is one nobody
# finished, and the other default ships a broken screen when a var is missed.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_FEATURE_TRAIN=true
EXPO_PUBLIC_FEATURE_FOOD=false
EXPO_PUBLIC_FEATURE_PROGRESS=true
EXPO_PUBLIC_FEATURE_MESSAGING=false
EXPO_PUBLIC_FEATURE_COMMUNITY=false
EXPO_PUBLIC_FEATURE_CHECK_INS=true
EXPO_PUBLIC_FEATURE_NOTIFICATIONS=false
EXPO_PUBLIC_FEATURE_INTEGRATIONS=false
