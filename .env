# Public runtime config, committed so every developer and EAS build shares the
# same defaults. Only EXPO_PUBLIC_* vars reach the app bundle, and everything
# in this file ships to devices — never put a service_role key or a Postgres
# connection string here. `.env.local` overrides anything set below.
EXPO_PUBLIC_API_URL=https://api.ligo.app

# Supabase Data API. The publishable key is designed to be public; Row Level
# Security on each table is what actually protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://tblujcawpwvedllowuuy.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_yaJG9PPcOdONyxsQt1YFVQ_jQ3-LqZN

# Run against src/api/mocks/ instead of the network. Still true because no
# endpoint module reads from Supabase yet — see src/api/supabase.ts.
EXPO_PUBLIC_USE_MOCKS=false

# Google sign-in needs NO credentials here. The client ID and secret belong in
# Supabase → Authentication → Providers → Google, which holds the secret
# server-side and does the token exchange. An OAuth client secret must never
# sit in this repo or in an EXPO_PUBLIC_* var — that ships it to every device.
