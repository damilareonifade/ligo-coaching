# Public runtime config. Only EXPO_PUBLIC_* vars reach the app bundle.
# NEVER put secrets here — the bundle is shipped to devices.
EXPO_PUBLIC_API_URL=https://api.ligo.app
EXPO_PUBLIC_USE_MOCKS=true

# Supabase — Settings → API keys in the dashboard. The publishable key
# (sb_publishable_…) is public by design; RLS is the security boundary.
# Never the service_role / secret key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your-publishable-key
