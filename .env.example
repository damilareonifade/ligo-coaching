# ---------------------------------------------------------------------------
# Template. Copy it, then fill in the two Supabase values:
#
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way. It was tracked in this repo
# until 2026-09-16 — the ignore rule covered `.env*.local` and so missed the
# one file that actually holds the project's config. This template is what the
# repo carries instead.
#
# Only public runtime config belongs in either file. Expo inlines every
# EXPO_PUBLIC_* var into the app bundle at build time, so anything written
# here ships to every device and is readable by anyone holding the app. A
# service_role key, a secret key or a Postgres connection string in this file
# is a compromised project — those live in Supabase function secrets, which
# the bundle never sees.
# ---------------------------------------------------------------------------

# The old axios backend. Dead (NXDOMAIN) and being migrated away from; kept
# because `src/lib/env.ts` still reads it and a handful of modules still call
# it — see the migration notes in supabase/README.md.
EXPO_PUBLIC_API_URL=https://api.ligo.app

# Run against src/api/mocks/ with no backend at all. The default for a fresh
# clone, so the app starts before anyone has Supabase credentials.
EXPO_PUBLIC_USE_MOCKS=true

# Supabase — dashboard → Project Settings → API keys.
#
# The publishable key (sb_publishable_…) is public by design: row-level
# security is the boundary, not secrecy. Never the service_role / secret key,
# which bypasses RLS entirely.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your-publishable-key

# ---------------------------------------------------------------------------
# Feature flags — "does this part of the app exist yet", not entitlement.
#
# Off unless the value is exactly `true`. A flag being off removes the feature
# everywhere at once: its tab, its routes, and every card elsewhere that reads
# from it. See src/lib/features.ts.
#
# The values below are the current state of the migration, and are the right
# defaults for a fresh clone.
# ---------------------------------------------------------------------------

# The training loop: routines, workouts, the Train tab.
EXPO_PUBLIC_FEATURE_TRAIN=true
# Body metrics, volume and PRs — the Progress tab.
EXPO_PUBLIC_FEATURE_PROGRESS=true
# Monthly check-ins.
EXPO_PUBLIC_FEATURE_CHECK_INS=true

# Food logging and Today's calories — not migrated.
EXPO_PUBLIC_FEATURE_FOOD=false
# Client ↔ coach threads and the coach's Messages tab. UI is built; there is
# no schema behind it yet.
EXPO_PUBLIC_FEATURE_MESSAGING=false
# Groups and leaderboards. Same state as messaging.
EXPO_PUBLIC_FEATURE_COMMUNITY=false
# Push notifications and the preferences that choose them. Parked — nothing
# sends one, and a switch storing a preference nothing acts on is a switch
# that lies.
EXPO_PUBLIC_FEATURE_NOTIFICATIONS=false
# Apple Health, Garmin, Whoop, Strava. No SDK installed and no OAuth
# configured, so there is nothing for a "Connect" to connect to.
EXPO_PUBLIC_FEATURE_INTEGRATIONS=false
