{
  "expo": {
    "name": "SetTrack",
    "slug": "settrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/SetTrack/ios/AppIcon~ios-marketing.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.settrack.coach"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8B5CF6",
        "foregroundImage": "./assets/brand/SetTrack/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "monochromeImage": "./assets/brand/SetTrack/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.settrack.coach"
    },
    "web": {
      "favicon": "./assets/brand/SetTrack/web/icon-512.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/SetTrack-wordmark-white.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#8B5CF6"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A3D62"
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "ligo",
    "experiments": {
      "typedRoutes": true
    }
  }
}
